# Copy this file to .env and fill in real values.

# PostgreSQL connection string. On Vercel, use the pooled connection string
# from your Vercel Postgres (Storage tab) — usually exposed as POSTGRES_PRISMA_URL.
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Auth.js session signing secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
