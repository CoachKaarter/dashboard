// Prisma schema — Cockpit U12/U13 (Saint-Sébastien FC)
// PostgreSQL (deployed on Vercel Postgres / Neon). No enums used, by
// convention from an earlier SQLite iteration; allowed value sets are
// validated at the application layer (zod) instead.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Staff / auth ----------

model User {
  id           String  @id @default(cuid())
  username     String  @unique
  passwordHash String
  name         String
  role         String // "ADMIN" | "COACH" | "STAFF"
  accessLabel  String // free text shown in Staff screen, e.g. "Équipes autorisées"
  jobTitle     String // e.g. "Responsable de catégorie", "Coach", "Entraîneur des gardiens"
  email        String?

  teams            Team[]             @relation("TeamCoach")
  notes            PlayerNote[]
  evaluations      EvaluationScore[]
  treatedAlerts    AlertTreated[]
  historyDecisions TeamHistoryEntry[]

  createdAt DateTime @default(now())
}

// ---------- Teams & players ----------

model Team {
  id       String @id @default(cuid())
  code     String @unique // "U13A"
  category String // "U12" | "U13"

  coach   User?   @relation("TeamCoach", fields: [coachId], references: [id])
  coachId String?

  players        Player[]
  sessions       TrainingSession[]
  matches        Match[]
  jerseys        Jersey[]
  calendarEvents CalendarEvent[]
  historyFrom    TeamHistoryEntry[] @relation("HistoryFromTeam")
  historyTo      TeamHistoryEntry[] @relation("HistoryToTeam")
}

model Player {
  id          String @id @default(cuid())
  firstName   String
  lastName    String
  birthYear   Int
  team        Team   @relation(fields: [teamId], references: [id])
  teamId      String
  position    String
  positionAlt String
  foot        String // "Gauche" | "Droit" | "Les deux"
  status      String // "Actif" | "Blessé" | "Malade"
  joinedLabel String // "Août 2022" (display string, matches prototype)

  notes            PlayerNote[]
  attendances      Attendance[]
  convocations     MatchConvocation[]
  compositionSlots CompositionSlot[]
  matchStats       MatchPlayerStat[]
  evaluations      EvaluationScore[]
  history          TeamHistoryEntry[]
  jerseys          Jersey[]

  createdAt DateTime @default(now())

  @@index([teamId])
}

model PlayerNote {
  id        String   @id @default(cuid())
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId  String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  text      String
  createdAt DateTime @default(now())

  @@index([playerId])
}

model TeamHistoryEntry {
  id          String   @id @default(cuid())
  player      Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId    String
  fromTeam    Team?    @relation("HistoryFromTeam", fields: [fromTeamId], references: [id])
  fromTeamId  String?
  toTeam      Team?    @relation("HistoryToTeam", fields: [toTeamId], references: [id])
  toTeamId    String?
  date        DateTime
  reason      String
  decidedBy   User?    @relation(fields: [decidedById], references: [id])
  decidedById String?

  @@index([playerId])
}

// ---------- Training sessions (séances) & presence ----------

model TrainingSession {
  id        String   @id @default(cuid())
  date      DateTime
  startTime String // "18:15"
  endTime   String // "19:45"
  location  String
  status    String // "Prévue" | "Réalisée"

  // A session targets either a whole category (U12 / U13) or one specific team
  // (e.g. "Spécifique U13A"); scopeTeam is set only in the latter case.
  category    String // "U12" | "U13"
  scopeTeam   Team?   @relation(fields: [scopeTeamId], references: [id])
  scopeTeamId String?
  label       String // "Séance commune" | "Spécifique U13A" | "Technique"

  attendances Attendance[]

  @@index([date])
}

model Attendance {
  id        String          @id @default(cuid())
  session   TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  player    Player          @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId  String
  code      String // "P" | "R" | "AJ" | "ANJ" | "B"

  @@unique([sessionId, playerId])
  @@index([playerId])
}

// ---------- Matches ----------

model Match {
  id           String   @id @default(cuid())
  team         Team     @relation(fields: [teamId], references: [id])
  teamId       String
  opponent     String? // null = "adversaire à définir"
  competition  String // "Championnat" | "Amical" | "Plateau"
  date         DateTime
  time         String? // "10:30"
  meetTime     String? // rendez-vous
  isHome       Boolean  @default(true)
  location     String?
  status       String // "Planifié" | "Joué"
  needed       Int      @default(12)
  formation    String   @default("1-3-3-1")
  scoreFor     Int?
  scoreAgainst Int?

  convocations MatchConvocation[]
  slots        CompositionSlot[]
  stats        MatchPlayerStat[]

  @@index([teamId])
  @@index([date])
}

model MatchConvocation {
  id       String @id @default(cuid())
  match    Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId  String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId String

  @@unique([matchId, playerId])
}

model CompositionSlot {
  id        String @id @default(cuid())
  match     Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId   String
  slotIndex Int // position index within the chosen formation (0..7)
  player    Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId  String

  @@unique([matchId, slotIndex])
  @@unique([matchId, playerId])
}

model MatchPlayerStat {
  id       String @id @default(cuid())
  match    Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId  String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId String
  role     String // "Titulaire" | "Remplaçant"
  minutes  Int
  goals    Int    @default(0)
  assists  Int    @default(0)
  note     Float?

  @@unique([matchId, playerId])
}

// ---------- Evaluations ----------

model EvaluationScore {
  id           String   @id @default(cuid())
  player       Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId     String
  period       String // "Septembre" | "Décembre" | "Mars" | "Juin"
  technique    Float
  tactique     Float
  physique     Float
  comportement Float
  comment      String?
  evaluator    User?    @relation(fields: [evaluatorId], references: [id])
  evaluatorId  String?
  createdAt    DateTime @default(now())

  @@unique([playerId, period])
}

// ---------- Jerseys / matériel ----------

model Jersey {
  id           String    @id @default(cuid())
  code         String    @unique // "SAC012"
  team         Team      @relation(fields: [teamId], references: [id])
  teamId       String
  player       Player?   @relation(fields: [playerId], references: [id])
  playerId     String?
  responsible  String // "Famille Berthier"
  issuedDate   DateTime
  dueDate      DateTime
  returnedDate DateTime?
  condition    String // "Bon" | "À laver" | "Abîmé"
}

// ---------- Planning: non-session/match events (réunions, tournois...) ----------

model CalendarEvent {
  id        String   @id @default(cuid())
  title     String
  kind      String // "reunion" | "tournoi" | "autre"
  date      DateTime
  startTime String
  endTime   String
  location  String?
  team      Team?    @relation(fields: [teamId], references: [id])
  teamId    String?
  teamLabel String // display label when not tied to one Team row, e.g. "Toutes"

  @@index([date])
}

// ---------- Alerts (computed) — persisted "treated" flags ----------

model AlertTreated {
  id          String   @id @default(cuid())
  alertKey    String   @unique // deterministic key, e.g. "match-no-opp:{matchId}"
  treatedBy   User?    @relation(fields: [treatedById], references: [id])
  treatedById String?
  treatedAt   DateTime @default(now())
}

// ---------- Settings (single row of tunable alert thresholds) ----------

model Settings {
  id             Int @id @default(1)
  seuilPresence  Int @default(60) // %
  fenetreSeances Int @default(5)
  absRecentes    Int @default(3)
  seuilANJ       Int @default(5)
  delaiEval      Int @default(60) // days
  ecartTdj       Int @default(90) // minutes
  delaiConvoc    Int @default(21) // days
  delaiMaillots  Int @default(3) // days
  periodeTdj     Int @default(30) // days
  horizonMatch   Int @default(10) // days
  minMinutes     Int @default(30)
  delaiRdv       Int @default(60) // minutes before kickoff
}
