// Prisma schema — Cockpit U12/U13 (Saint-Sébastien FC)
// PostgreSQL (deployed on Vercel Postgres / Neon). No enums used, by
// convention from an earlier SQLite iteration; allowed value sets are
// validated at the application layer (zod) instead.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Staff / auth ----------

model User {
  id                    String    @id @default(cuid())
  username              String    @unique
  passwordHash          String
  name                  String
  role                  String // "ADMIN" | "COACH" | "STAFF" — TECHNICAL role only (staff CRUD, club branding, paramètres). Does NOT by itself grant sporting data access anymore — see StaffAccess.
  accessLabel           String // free text shown in Staff screen, e.g. "Équipes autorisées"
  jobTitle              String // e.g. "Responsable de catégorie", "Coach", "Entraîneur des gardiens"
  email                 String?
  phone                 String? // affiché sur la feuille de convocation (poster) quand ce membre du staff encadre un match
  active                Boolean   @default(true) // false = compte désactivé, connexion bloquée
  // Legacy sporting scope, superseded by StaffAccess (multi-catégories staff
  // permissions pass). Frozen: no longer written to by new code, kept only
  // so the one-time migration that derived each user's StaffAccess rows has
  // a record of what it read. Do not add new call sites reading this field —
  // use getAccessibleTeamIds(user)/StaffAccess instead.
  teamIds               String[]  @default([])
  onboardingCompletedAt DateTime? // null = show the first-login onboarding flow

  teams                         Team[]                       @relation("TeamCoach")
  notes                         PlayerNote[]
  evaluations                   EvaluationScore[]
  treatedAlerts                 AlertTreated[]               @relation("AlertTreatedBy")
  assignedAlerts                AlertTreated[]               @relation("AlertAssignee")
  historyDecisions              TeamHistoryEntry[]
  unavailabilities              Unavailability[]
  activityLogs                  ActivityLog[]
  notifications                 Notification[]
  weekendAssignmentsMade        WeekendAssignment[]
  matchStaffRoles               MatchStaffAssignment[]
  weekendPlansValidated         WeekendPlan[]
  interviews                    PlayerInterview[]
  objectivesCreated             PlayerObjective[]
  attendanceUpdates             Attendance[]
  sessionExpectationUpdates     SessionExpectation[]
  contentItemsCreated           TrainingContentItem[]
  contentFavorites              TrainingContentFavorite[]
  templatesCreated              SessionTemplate[]
  announcementsPosted           StaffAnnouncement[]
  physicalTestsRecorded         PhysicalTestResult[]
  staffAccess                   StaffAccess[]                @relation("StaffAccessUser")
  staffAccessGranted            StaffAccess[]                @relation("StaffAccessGrantedBy")
  equipmentAssignmentsMade      EquipmentAssignment[]
  parentInvitationsCreated      ParentInvitation[]
  familyInfoSubmissionsReviewed PlayerFamilyInfoSubmission[]
  tournamentInvitationsCreated  TournamentInvitation[]       @relation("TournamentInvitationCreatedBy")
  tournamentInvitationsDecided  TournamentInvitation[]       @relation("TournamentInvitationDecidedBy")

  createdAt DateTime @default(now())
}

// A user's real sporting permissions: one row per (level × scope) grant,
// cumulative — Davy is RESPONSABLE on U8, RESPONSABLE on U9, and COACH on
// one team, all at once, via three separate rows. See src/lib/authz.ts for
// how these are turned into effective team/category access; nothing reads
// this table directly outside that module.
model StaffAccess {
  id     String @id @default(cuid())
  user   User   @relation("StaffAccessUser", fields: [userId], references: [id], onDelete: Cascade)
  userId String

  level String // "COACH" | "RESPONSABLE" — day-to-day operation vs. full pilotage of the scope
  scope String // "TEAM" | "CATEGORY" | "SCHOOL"

  // Exactly one of category/teamId is set, matching `scope` — enforced at
  // the application layer (Zod) since Postgres can't express "exactly one
  // of these two columns" declaratively without a CHECK constraint we'd
  // rather keep out of a hand-rolled migration.
  category String? // set when scope = "CATEGORY" ("U8", "U12"...)
  team     Team?   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId   String? // set when scope = "TEAM"
  // scope = "SCHOOL" sets neither — it expands to every category listed in
  // Settings.schoolFootballCategories at read time, so the perimeter can be
  // redefined in Paramètres without touching every school-wide grant.

  grantedBy   User?    @relation("StaffAccessGrantedBy", fields: [grantedById], references: [id])
  grantedById String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([teamId])
}

// ---------- Teams & players ----------

model Team {
  id         String  @id @default(cuid())
  code       String  @unique // "U13A"
  category   String // "U12" | "U13"
  format     String  @default("Foot à 8") // "Foot à 8" | "Foot à 11"
  targetSize Int? // effectif cible — comparé à l'effectif réel sur l'écran Équipes
  // Niveau de compétition (ex. "ELITE", "D1", "D3") — affiché comme
  // "{category} {level}" (ex. "U12 ELITE"). Jamais déduit ou recopié d'une
  // autre équipe : une équipe sans niveau configuré affiche "À confirmer"
  // plutôt qu'une valeur incorrecte (voir feuille de convocation).
  level      String?

  // Valeurs par défaut "infos parents" de l'équipe (niveau 1 de la
  // hiérarchie d'héritage — voir src/lib/match-parent-info.ts). Toutes
  // facultatives : une équipe qui n'en règle aucune hérite simplement du
  // modèle de match puis des réglages généraux du club (Settings.delaiRdv).
  // Jamais recopiées physiquement dans chaque Match — un changement ici se
  // répercute sur tout match NON PUBLIÉ, jamais sur un match déjà publié
  // (Match.parentInfoPublishedAt fige l'héritage à cet instant).
  meetTimeDeltaMinutes      Int? // RDV habituel = coup d'envoi - X minutes
  defaultTransportMode      String? // "RDV_SUR_PLACE" | "DEPART_COLLECTIF" | "COVOITURAGE" | "AUTRE"
  defaultDressCode          String?
  defaultPersonalGear       String?
  defaultMealInfo           String?
  defaultParentInstructions String?
  defaultDurationMinutes    Int? // pour calculer une fin de match estimée
  defaultReturnDelayMinutes Int? // délai après la fin pour calculer un retour estimé

  coach   User?   @relation("TeamCoach", fields: [coachId], references: [id])
  coachId String?

  players            Player[]
  sessions           TrainingSession[]
  recurringSlots     RecurringSlot[]
  matches            Match[]
  equipment          Equipment[]
  calendarEvents     CalendarEvent[]
  announcements      StaffAnnouncement[]
  historyFrom        TeamHistoryEntry[]  @relation("HistoryFromTeam")
  historyTo          TeamHistoryEntry[]  @relation("HistoryToTeam")
  weekendAssignments WeekendAssignment[]
  staffAccess        StaffAccess[]
}

// Niveau 2 — lieu/stade enregistré une fois, réutilisé sur tous les matchs
// qui s'y jouent. Match.location/venueAddress restent les champs affichés
// partout dans l'app (poster, espace parent, messages) — choisir un Venue
// ne fait que les PRÉ-REMPLIR à la création, jamais un lien vivant : rien
// d'autre à modifier dans le reste du code, et un match garde son adresse
// même si le Venue est renommé ensuite.
model Venue {
  id           String   @id @default(cuid())
  name         String   @unique
  address      String?
  city         String?
  postalCode   String?
  meetingPoint String? // point de rendez-vous habituel sur ce lieu
  parkingInfo  String?
  accessInfo   String?
  notes        String?
  matches      Match[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Niveau 3 — modèle de match réutilisable (ex. "Championnat — Extérieur"),
// sélectionné automatiquement à la création selon competition/isHome
// (src/lib/match-parent-info.ts:selectMatchTemplate) mais toujours
// modifiable. Un même modèle sert à toutes les catégories/équipes du club —
// aucune hypothèse U12/U13 ici (§27).
model MatchTemplate {
  id                   String   @id @default(cuid())
  name                 String   @unique
  competition          String? // filtre de sélection auto — null = s'applique à tous les types
  isHome               Boolean? // filtre de sélection auto — null = domicile ET extérieur (ex. Tournoi)
  meetTimeDeltaMinutes Int?
  transportMode        String?
  dressCode            String?
  personalGear         String?
  mealInfo             String?
  parentInstructions   String?
  durationMinutes      Int?
  returnDelayMinutes   Int?
  isDefault            Boolean  @default(false) // fourni par le produit — les responsables peuvent en créer d'autres
  matches              Match[]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Player {
  id          String  @id @default(cuid())
  firstName   String
  lastName    String
  birthYear   Int
  // Catégorie du joueur (ex. "U12") — source de vérité permanente,
  // indépendante de teamId : un joueur n'est plus jamais rattaché à une
  // équipe précise (U12A/B/C) par défaut, seulement à sa catégorie. Même
  // idiome que TrainingSession.category/RecurringSlot.category (texte
  // simple, pas une FK).
  category    String
  // Équipe précise, désormais optionnelle — n'est plus jamais exigée à la
  // création/import, seulement écrite quand un responsable choisit
  // explicitement de "fixer" un joueur sur une équipe (Changer de groupe).
  // Quand null, l'équipe "actuelle" affichée est CALCULÉE depuis les
  // matchs réellement joués (voir computeUsualTeamCode dans
  // src/lib/player-history.ts) — jamais un champ stocké séparément, pour
  // éviter toute désynchronisation.
  team        Team?   @relation(fields: [teamId], references: [id])
  teamId      String?
  position    String
  positionAlt String
  foot        String // "Gauche" | "Droit" | "Les deux"
  status      String // "Actif" | "Blessé" | "Malade" | "Incertain" | "Reprise"
  joinedLabel String // "Août 2022" (display string, matches prototype)
  archived    Boolean @default(false) // joueur parti du club — masqué des listes actives, historique conservé

  // Coordonnées administratives d'un parent/responsable légal, saisies par
  // le staff — distinctes de ParentAccount (identifiants de connexion à
  // l'espace parents, aucun rapport avec ces champs).
  parentName  String?
  parentPhone String?
  parentEmail String?

  // Numéro de licence + date de naissance précise — remplis uniquement par
  // validation staff d'une PlayerFamilyInfoSubmission déclarée par la
  // famille (jamais écrits directement depuis l'espace parent). birthDate
  // s'ajoute à birthYear sans le remplacer : birthYear reste la source de
  // vérité utilisée partout ailleurs dans l'app.
  licenseNumber String?
  birthDate     DateTime?

  notes                 PlayerNote[]
  attendances           Attendance[]
  convocations          MatchConvocation[]
  compositionSlots      CompositionSlot[]
  matchStats            MatchPlayerStat[]
  evaluations           EvaluationScore[]
  history               TeamHistoryEntry[]
  equipmentAssignments  EquipmentAssignment[]
  unavailabilities      Unavailability[]
  parentAccounts        ParentAccountPlayer[]
  parentInvitations     ParentInvitation[]
  familyInfoSubmissions PlayerFamilyInfoSubmission[]
  contentStates         ParentContentState[]
  availabilities        PlayerAvailability[]
  sessionFeedback       SessionFeedback[]
  weekendAssignments    WeekendAssignment[]
  interviews            PlayerInterview[]
  objectives            PlayerObjective[]
  physicalTests         PhysicalTestResult[]
  sessionExpectations   SessionExpectation[]

  createdAt DateTime @default(now())

  @@index([teamId])
  @@index([category])
}

model Unavailability {
  id             String    @id @default(cuid())
  player         Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId       String
  type           String // "Blessure" | "Maladie" | "Absence longue" | "Autre"
  description    String?
  startDate      DateTime
  expectedReturn DateTime?
  actualReturn   DateTime? // renseigné quand le joueur est marqué de retour
  createdBy      User?     @relation(fields: [createdById], references: [id])
  createdById    String?
  source         String    @default("STAFF") // "STAFF" | "PARENT"
  status         String    @default("VALIDATED") // "PENDING" | "VALIDATED" | "REFUSED" — PENDING seulement pour source=PARENT
  createdAt      DateTime  @default(now())

  @@index([playerId])
}

// ---------- Espace Parents / Joueurs ----------

// Compte famille — identité de connexion d'UNE FAMILLE, plus 1:1 avec un
// joueur : plusieurs enfants peuvent être liés au même compte via
// ParentAccountPlayer (même idiome que StaffAccess côté staff — une
// identité, plusieurs lignes de scope). Volontairement séparé du modèle
// User (staff) : aucune permission d'équipe, aucun accès au Cockpit
// interne, et une session cookie distincte (voir src/parent-auth.ts) pour
// qu'il n'y ait jamais de confusion possible entre les deux systèmes
// d'identité.
model ParentAccount {
  id                    String                       @id @default(cuid())
  // Email de la famille — sert à détecter automatiquement qu'un 2e enfant
  // doit rejoindre ce compte existant plutôt que d'en créer un nouveau
  // (voir activateParentAccount dans src/lib/parent-activation.ts).
  email                 String
  // Coordonnées propres du parent, saisies par lui-même lors de
  // l'onboarding obligatoire (/parent/informations) — écrites directement,
  // jamais soumises à validation staff (contrairement aux infos de
  // l'enfant, voir PlayerFamilyInfoSubmission). Distinct des champs
  // Player.parentName/parentPhone (coordonnées administratives saisies par
  // le staff sur la fiche joueur).
  firstName             String?
  lastName              String?
  phone                 String?
  username              String                       @unique
  passwordHash          String
  active                Boolean                      @default(true)
  mustChangePassword    Boolean                      @default(true)
  lastLoginAt           DateTime?
  // Passage obligatoire par /parent/informations avant tout autre écran,
  // même mécanisme que User.onboardingCompletedAt côté staff
  // (decideOnboardingRedirect) — backfillé à la migration pour les comptes
  // déjà activés, ne s'applique qu'aux comptes créés après ce déploiement.
  onboardingCompletedAt DateTime?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  players               ParentAccountPlayer[]
  contentStates         ParentContentState[]
  equipmentAssignments  EquipmentAssignment[]
  passwordResetTokens   ParentPasswordResetToken[]
  familyInfoSubmissions PlayerFamilyInfoSubmission[]
}

// Table de liaison many-to-many ParentAccount<->Player. playerId reste
// unique SEUL (pas composite) : un enfant donné n'appartient qu'à un seul
// compte famille à la fois — c'est exactement l'invariant que
// ParentAccount.playerId @unique garantissait avant cette refonte, juste
// déplacé ici pour permettre à un compte d'avoir plusieurs lignes.
model ParentAccountPlayer {
  id              String        @id @default(cuid())
  parentAccount   ParentAccount @relation(fields: [parentAccountId], references: [id], onDelete: Cascade)
  parentAccountId String
  player          Player        @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId        String        @unique
  createdAt       DateTime      @default(now())

  @@index([parentAccountId])
}

// Déclaration par un parent des informations officielles de son enfant
// (nom, date de naissance, numéro de licence) lors de l'onboarding — même
// idiome que Unavailability.source/status : jamais écrit directement sur
// Player, en attente de validation staff (validatePlayerFamilyInfo /
// refusePlayerFamilyInfo dans src/app/(app)/joueurs/[id]/actions.ts).
model PlayerFamilyInfoSubmission {
  id            String        @id @default(cuid())
  player        Player        @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId      String
  submittedBy   ParentAccount @relation(fields: [submittedById], references: [id], onDelete: Cascade)
  submittedById String
  firstName     String
  lastName      String
  birthDate     DateTime
  licenseNumber String
  status        String        @default("PENDING") // "PENDING" | "VALIDATED" | "REFUSED"
  reviewedBy    User?         @relation(fields: [reviewedById], references: [id])
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime      @default(now())

  @@index([playerId])
  @@index([status])
}

// Droit d'accès accordé par le club à un parent, avant toute activation —
// remplace l'ancien flux "mot de passe temporaire envoyé par email" (voir
// src/lib/email.ts). Un ParentAccount n'est créé QUE lorsque le parent
// active réellement son invitation (option retenue : jamais de compte
// "actif" avant activation réelle — cf. audit du 27/08). Le jeton brut
// n'existe jamais en base, seulement son empreinte (tokenHash) — voir
// src/lib/parent-invitation-token.ts.
model ParentInvitation {
  id          String    @id @default(cuid())
  player      Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId    String
  email       String
  // Identifiant réservé pour ce parent dès la préparation de l'invitation
  // (généré une seule fois, jamais régénéré par un renvoi) — permet au
  // staff de le voir avant l'envoi, et devient le username du ParentAccount
  // créé à l'activation. generateUsername() doit vérifier son unicité à la
  // fois contre ParentAccount ET contre les autres invitations non
  // révoquées/non expirées, pour éviter que deux familles distinctes ne se
  // voient réserver le même identifiant avant activation.
  username    String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  sentAt      DateTime?
  createdBy   User?     @relation(fields: [createdById], references: [id])
  createdById String?

  @@index([playerId])
  @@index([email])
  @@index([expiresAt])
}

// Jeton de réinitialisation de mot de passe — même discipline que
// ParentInvitation (jeton brut jamais stocké, usage unique, expiration
// courte : 30 minutes au lieu de 72h, voir src/lib/parent-password-reset.ts).
model ParentPasswordResetToken {
  id              String        @id @default(cuid())
  parentAccount   ParentAccount @relation(fields: [parentAccountId], references: [id], onDelete: Cascade)
  parentAccountId String
  tokenHash       String        @unique
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime      @default(now())

  @@index([parentAccountId])
  @@index([expiresAt])
}

// Compteur générique pour un rate limiting compatible serverless/Vercel —
// une Map en mémoire ne fonctionnerait pas (plusieurs instances, chacune sa
// propre mémoire) ; ce compteur vit dans Postgres, déjà accessible via
// Prisma, donc correct par construction quel que soit le nombre d'instances.
// "key" identifie la ressource limitée, ex. "parent-login:kyllian.gabala",
// "activation:203.0.113.4", "forgot-password:famille@mail.fr" — voir
// src/lib/rate-limit.ts. Nettoyage opportuniste des lignes expirées à
// chaque vérification, pas de job planifié nécessaire à ce volume.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// Accueil Parent v2 — mémoire NEW/SEEN/COMPLETED d'un contenu pour un
// compte parent donné, plus un instantané JSON minimal des champs
// affichés au moment où le parent l'a vu. Une seule table générique
// (spec §8 : "éviter de créer 15 champs seenAt différents") au lieu
// d'ajouter un champ par modèle (Match, TrainingSession, PlayerObjective,
// StaffAnnouncement... n'ont pas de seenAt et ne doivent pas en gagner
// un chacun) — voir src/lib/parent-content-state.ts.
//
// lastSnapshot sert aussi à détecter les MODIFICATIONS (convocation
// déplacée, séance dont l'horaire change) sans dépendre d'un
// updatedAt sur Match/TrainingSession, qui n'existe pas : le moteur de
// priorité recompare l'état actuel à ce dernier instantané connu à
// chaque rendu — un écart = contenu modifié, remis en avant.
model ParentContentState {
  id              String        @id @default(cuid())
  parentAccount   ParentAccount @relation(fields: [parentAccountId], references: [id], onDelete: Cascade)
  parentAccountId String
  // Quel enfant du compte ce contenu concerne — indispensable depuis que
  // ParentAccount peut avoir plusieurs enfants : sans ça, marquer une
  // AVAILABILITY_WEEK "vue" pour l'un la marquerait aussi vue pour l'autre
  // (entityId est une date de semaine, pas un id joueur).
  player          Player        @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId        String
  entityType      String // "AVAILABILITY_WEEK" | "CONVOCATION" | "TRAINING_SESSION" | "OBJECTIVE" | "OBJECTIVE_UPDATE" | "ANNOUNCEMENT"
  entityId        String // ex. weekStartDate ISO, MatchConvocation.id, TrainingSession.id, PlayerObjective.id...
  seenAt          DateTime?
  completedAt     DateTime?
  lastSnapshot    Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([parentAccountId, playerId, entityType, entityId])
  @@index([parentAccountId])
  @@index([playerId])
}

// Disponibilité PRÉVISIONNELLE déclarée par la famille — distincte
// d'Attendance (présence RÉELLE pointée par le coach) et de
// MatchConvocation (décision officielle du staff). Ne jamais fusionner ces
// concepts : voir la note dans src/lib/availability.ts.
model PlayerAvailability {
  id            String           @id @default(cuid())
  player        Player           @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId      String
  session       TrainingSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId     String? // non-null pour type=TRAINING, toujours null pour type=WEEKEND
  weekStartDate DateTime // lundi de la semaine concernée — aligné sur WeeklyAvailabilityWindow
  eventDate     DateTime // date réelle concernée (date de la séance, ou le samedi pour WEEKEND)
  type          String // "TRAINING" | "WEEKEND"
  status        String // "AVAILABLE" | "UNAVAILABLE"
  absenceReason String? // "Maladie" | "Famille" | "École" | "Autre" — uniquement si UNAVAILABLE, jamais obligatoire
  comment       String?
  answeredBy    String           @default("PARENT") // "PARENT" | "STAFF" (saisie manuelle par le staff)
  answeredAt    DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([playerId, eventDate, type]) // une seule réponse par joueur, par jour concerné, par type
  @@index([playerId, weekStartDate])
  @@index([sessionId])
}

// Fenêtre hebdomadaire de réponse, contrôlée par le staff (page /disponibilites).
model WeeklyAvailabilityWindow {
  id            String    @id @default(cuid())
  weekStartDate DateTime  @unique // lundi, normalisé à minuit
  weekEndDate   DateTime
  opensAt       DateTime?
  closesAt      DateTime?
  status        String    @default("CLOSED") // "CLOSED" (jamais ouverte) | "OPEN" | "LOCKED" (clôturée après avoir été ouverte)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Questionnaire joueur pré/post-séance + charge perçue (RPE × durée).
// Volontairement présenté comme un indicateur de tendance, pas une mesure
// médicale — voir l'avertissement affiché dans la vue staff wellness.
model SessionFeedback {
  id        String          @id @default(cuid())
  session   TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  player    Player          @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId  String

  preFeeling    Int? // 1 (😩) à 5 (😄)
  fatigue       String? // "Pas du tout" | "Un peu" | "Beaucoup"
  pain          Boolean?
  painLocation  String?
  preAnsweredAt DateTime?

  postFeeling    Int? // 1 à 5
  rpe            Int? // 1 à 10 — difficulté perçue
  enjoyment      Int? // 1 (pas trop) à 3 (beaucoup)
  comment        String?
  postAnsweredAt DateTime?

  calculatedLoad Int? // durée de la séance (minutes) × RPE

  @@unique([sessionId, playerId])
}

model PlayerNote {
  id        String   @id @default(cuid())
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId  String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  text      String
  createdAt DateTime @default(now())

  @@index([playerId])
}

model TeamHistoryEntry {
  id          String   @id @default(cuid())
  player      Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId    String
  fromTeam    Team?    @relation("HistoryFromTeam", fields: [fromTeamId], references: [id])
  fromTeamId  String?
  toTeam      Team?    @relation("HistoryToTeam", fields: [toTeamId], references: [id])
  toTeamId    String?
  date        DateTime
  reason      String
  decidedBy   User?    @relation(fields: [decidedById], references: [id])
  decidedById String?

  @@index([playerId])
}

// ---------- Recurring training template ----------

model RecurringSlot {
  id          String  @id @default(cuid())
  category    String // "U12" | "U13"
  scopeTeam   Team?   @relation(fields: [scopeTeamId], references: [id])
  scopeTeamId String?
  weekday     Int // 0=dimanche .. 6=samedi
  startTime   String // "18:15"
  endTime     String // "19:45"
  location    String
  label       String // "Séance commune" | "Spécifique U13A" | "Technique"
  active      Boolean @default(true) // false = suspendu, ne génère plus de séances

  sessions TrainingSession[]

  createdAt DateTime @default(now())
}

// ---------- Training sessions (séances) & presence ----------

model TrainingSession {
  id        String   @id @default(cuid())
  date      DateTime
  startTime String // "18:15"
  endTime   String // "19:45"
  location  String
  status    String // "Prévue" | "Réalisée" | "Annulée"

  // A session targets either a whole category (U12 / U13) or one specific team
  // (e.g. "Spécifique U13A"); scopeTeam is set only in the latter case.
  category    String // "U12" | "U13"
  scopeTeam   Team?   @relation(fields: [scopeTeamId], references: [id])
  scopeTeamId String?
  label       String // "Séance commune" | "Spécifique U13A" | "Technique"
  theme       String? // thème de la séance, ex. "Conservation du ballon"
  objective   String? // objectif pédagogique, ex. "Jouer sous pression en 2 touches"

  // Set when this session was auto-generated from a RecurringSlot, so the
  // generator can tell which weeks already have a session and skip them —
  // editing/cancelling/deleting this row (an "exception") doesn't touch the
  // template itself.
  sourceSlot   RecurringSlot? @relation(fields: [sourceSlotId], references: [id])
  sourceSlotId String?

  // Soft-delete marker, set only when deleteSession() can't hard-delete a row
  // that matches an active RecurringSlot (see src/lib/recurring.ts —
  // ensureUpcomingSessions() decides "already generated" purely from row
  // existence, so a real delete would get it silently recreated). Every
  // display query must filter deletedAt: null; ensureUpcomingSessions()
  // deliberately does NOT, so it still sees — and skips — this row.
  deletedAt DateTime?

  attendances     Attendance[]
  availabilities  PlayerAvailability[]
  sessionFeedback SessionFeedback[]
  blocks          SessionBlock[]
  expectations    SessionExpectation[]

  @@index([date])
}

// Effectif attendu à CETTE séance précise — décision d'organisation STAFF,
// distincte de PlayerAvailability (réponse FAMILLE) et d'Attendance
// (présence RÉELLE pointée par le coach). Initialisée automatiquement à la
// création/premier accès d'une séance (voir ensureSessionExpectations() dans
// src/lib/session-expectation.ts) à partir du scope naturel (équipe ou
// catégorie), jamais réécrite automatiquement ensuite — seule une action
// staff explicite (bascule individuelle, action groupée, ajout exceptionnel)
// modifie une ligne existante. Player.teamId ne change jamais à cause de
// cette table : un joueur peut être "attendu" sur une séance en dehors de
// son équipe habituelle sans que son affectation administrative bouge.
model SessionExpectation {
  id          String          @id @default(cuid())
  session     TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId   String
  player      Player          @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId    String
  expected    Boolean
  updatedBy   User?           @relation(fields: [updatedById], references: [id])
  updatedById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([sessionId, playerId])
  @@index([sessionId])
  @@index([playerId])
}

model Attendance {
  id        String          @id @default(cuid())
  session   TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  player    Player          @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId  String
  code      String // "P" | "R" | "AJ" | "ANJ" | "B"
  note      String? // motif — ex. raison d'une absence justifiée (AJ)

  arrivalTime DateTime? // instant réel du tap "R" — sert à calculer le retard vs TrainingSession.startTime
  updatedBy   User?     @relation(fields: [updatedById], references: [id])
  updatedById String?
  updatedAt   DateTime? // renseigné manuellement à chaque écriture (pas @updatedAt : pas de valeur par défaut nécessaire sur les lignes historiques)

  @@unique([sessionId, playerId])
  @@index([playerId])
}

// Procédé d'une séance, préparé côté Cockpit desktop et consulté/piloté
// depuis l'Espace Coach mobile sur le terrain. Le contenu pédagogique
// (organisation, consignes, matériel...) est distinct du pointage
// (Attendance) et de la disponibilité familiale (PlayerAvailability) — ne
// jamais fusionner ces concepts.
model SessionBlock {
  id        String          @id @default(cuid())
  session   TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  order     Int

  type            String // "ACCUEIL" | "ACTIVATION" | "TECHNIQUE" | "EXERCICE" | "SITUATION" | "JEU" | "PHYSIQUE" | "RETOUR_AU_CALME" | "AUTRE"
  title           String
  durationMinutes Int
  objective       String?
  organization    String?
  instructions    String?
  coachingPoints  String? // points de coaching — copiés depuis la bibliothèque puis librement adaptés pour cette séance
  variations      String? // variantes — idem
  space           String?
  equipment       String?
  imageUrl        String?
  coachNote       String? // jamais exposé côté parent/joueur

  // Provenance uniquement — SessionBlock reçoit une COPIE au moment de
  // l'ajout (voir TrainingContentItem). Modifier la bibliothèque plus tard
  // ne doit jamais changer rétroactivement une séance déjà préparée/jouée ;
  // SetNull si l'item source est supprimé, le snapshot ci-dessus survit.
  sourceLibraryItem   TrainingContentItem? @relation("SessionBlockSource", fields: [sourceLibraryItemId], references: [id], onDelete: SetNull)
  sourceLibraryItemId String?

  status                String    @default("PENDING") // "PENDING" | "IN_PROGRESS" | "DONE" | "SKIPPED"
  startedAt             DateTime?
  endedAt               DateTime?
  actualDurationMinutes Int? // temps réellement actif (pauses exclues) — durationMinutes prévue reste intacte

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, order])
  @@index([sessionId])
  @@index([sourceLibraryItemId])
}

// ---------- Bibliothèque de procédés (V5.1) ----------
// LibraryItem = modèle réutilisable. SessionBlock/SessionTemplateBlock =
// snapshot copié au moment de l'ajout. Modifier un TrainingContentItem ne
// doit JAMAIS changer rétroactivement une séance ou un template déjà
// préparés — voir le principe d'historisation dans le cahier des charges V5.1.
model TrainingContentItem {
  id    String @id @default(cuid())
  title String
  type  String // même référentiel que SessionBlock.type — "ACCUEIL" | "ACTIVATION" | "TECHNIQUE" | "EXERCICE" | "SITUATION" | "JEU" | "PHYSIQUE" | "RETOUR_AU_CALME" | "AUTRE"

  description    String?
  objective      String?
  organization   String?
  instructions   String?
  coachingPoints String?
  variations     String?
  space          String?
  equipment      String?
  imageUrl       String?

  defaultDurationMinutes Int?
  minPlayers             Int?
  maxPlayers             Int?
  format                 String? // "Foot à 5" | "Foot à 8" | "Foot à 11" | "Tous"
  categories             String[] @default([]) // indicatif seulement, ex. ["U12", "U13"] — jamais bloquant

  createdBy   User    @relation(fields: [createdById], references: [id])
  createdById String
  visibility  String  @default("PERSONAL") // "PERSONAL" | "SHARED"
  archived    Boolean @default(false)

  tags           TrainingContentTag[]      @relation("ContentItemTags")
  favoritedBy    TrainingContentFavorite[]
  sessionBlocks  SessionBlock[]            @relation("SessionBlockSource")
  templateBlocks SessionTemplateBlock[]    @relation("TemplateBlockSource")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
  @@index([type])
  @@index([archived])
  @@index([visibility])
}

model TrainingContentTag {
  id       String  @id @default(cuid())
  name     String  @unique
  slug     String  @unique
  category String?

  items TrainingContentItem[] @relation("ContentItemTags")

  createdAt DateTime @default(now())
}

// Favoris individuels — un procédé peut être favori pour un coach et pas pour un autre.
model TrainingContentFavorite {
  id            String              @id @default(cuid())
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  contentItem   TrainingContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  contentItemId String
  createdAt     DateTime            @default(now())

  @@unique([userId, contentItemId])
  @@index([contentItemId])
}

// Modèle de séance réutilisable — même principe de snapshot que SessionBlock
// vis-à-vis de la bibliothèque : modifier un TrainingContentItem après coup
// ne doit jamais changer un template déjà sauvegardé.
model SessionTemplate {
  id          String  @id @default(cuid())
  name        String
  description String?
  createdBy   User    @relation(fields: [createdById], references: [id])
  createdById String
  visibility  String  @default("PERSONAL") // "PERSONAL" | "SHARED"
  archived    Boolean @default(false)

  blocks SessionTemplateBlock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
  @@index([archived])
}

model SessionTemplateBlock {
  id         String          @id @default(cuid())
  template   SessionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId String
  order      Int

  type            String
  title           String
  durationMinutes Int
  objective       String?
  organization    String?
  instructions    String?
  coachingPoints  String?
  variations      String?
  space           String?
  equipment       String?
  imageUrl        String?

  sourceLibraryItem   TrainingContentItem? @relation("TemplateBlockSource", fields: [sourceLibraryItemId], references: [id], onDelete: SetNull)
  sourceLibraryItemId String?

  @@unique([templateId, order])
  @@index([templateId])
  @@index([sourceLibraryItemId])
}

// ---------- Matches ----------

model Match {
  id           String   @id @default(cuid())
  team         Team     @relation(fields: [teamId], references: [id])
  teamId       String
  opponent     String? // null = "adversaire à définir"
  competition  String // "Championnat" | "Amical" | "Tournoi" | "Coupe" | "Plateau" | "Autre"
  date         DateTime
  time         String? // "10:30"
  meetTime     String? // heure de rendez-vous
  meetLocation String? // lieu de rendez-vous — peut différer du terrain (location), ex. parking du club avant un déplacement
  isHome       Boolean  @default(true)
  location     String?
  surface      String? // "Synthétique" | "Naturelle" | "Stabilisé" | "Autre" — voir src/lib/match-validation.ts
  status       String // "Planifié" | "Joué"
  needed       Int      @default(12)
  formation    String   @default("1-3-3-1")
  scoreFor     Int?
  scoreAgainst Int?
  shareToken   String   @unique @default(cuid()) // lien de convocation partageable, sans connexion

  preMatchObjective String? // objectif fixé avant le match
  mainInstructions  String? // consignes principales avant-match — STAFF UNIQUEMENT, jamais montré aux parents
  preMatchNotes     String? // notes libres avant-match — STAFF UNIQUEMENT

  // Fiche de convocation côté parent (Cockpit v1.1) — informations
  // pratiques distinctes des champs tactiques ci-dessus (préMatchObjective/
  // mainInstructions/preMatchNotes restent internes au staff). Tous
  // facultatifs : un champ non renseigné est simplement masqué côté parent,
  // jamais affiché comme une ligne vide.
  estimatedEndTime    String? // heure de fin estimée du match, ex. "11:30" — affichée avec la mention "estimée"
  estimatedReturnTime String? // heure de retour estimée, ex. "12:15" — idem
  venueAddress        String? // adresse complète du lieu (le nom court reste dans `location`) — alimente "Ouvrir dans Maps"
  transportMode       String? // "RDV_SUR_PLACE" | "DEPART_COLLECTIF" | "COVOITURAGE" | "AUTRE"
  dressCode           String? // tenue demandée, ex. "Survêtement club, crampons"
  personalGear        String? // matériel personnel à prévoir, ex. "Gourde, protège-tibias"
  mealInfo            String? // repas / collation à prévoir
  parentInstructions  String? // consignes du staff DESTINÉES AUX PARENTS — distinct de mainInstructions (tactique interne)
  parentNotes         String? // informations complémentaires visibles des parents

  // Préremplissage "infos parents" (voir src/lib/match-parent-info.ts) —
  // TOUS les champs ci-dessus restent la source affichée partout dans
  // l'app ; ils ne signifient plus "vide = rien à afficher" mais "vide =
  // hérité du modèle puis de l'équipe puis des réglages du club" tant que
  // parentInfoPublishedAt est null. Une valeur non nulle dans un de ces
  // champs a toujours été et reste un override explicite pour CE match.
  venue                 Venue?         @relation(fields: [venueId], references: [id], onDelete: SetNull)
  venueId               String?
  matchTemplate         MatchTemplate? @relation(fields: [matchTemplateId], references: [id], onDelete: SetNull)
  matchTemplateId       String?
  // Renseigné au moment où les convocations de ce match sont publiées pour
  // la première fois : à cet instant, chaque champ hérité ci-dessus est
  // réécrit avec sa valeur RÉSOLUE (devenant de fait un override figé) —
  // un changement ultérieur des réglages Team/MatchTemplate ne modifie donc
  // plus jamais un match déjà publié. Pas de blob JSON séparé : les mêmes
  // colonnes structurées servent avant et après publication.
  parentInfoPublishedAt DateTime?

  // Tournoi uniquement (competition = "Tournoi") — score global facultatif,
  // classement final possible sans score. Restent vides tant que le
  // tournoi n'est pas terminé.
  tournamentRanking    Int? // ex: 3
  tournamentTeamsCount Int? // ex: 16

  // Lien traçable — jamais obligatoire — vers l'invitation de tournoi dont
  // ce match est né (src/app/(app)/tournois). Un match "Tournoi" reste
  // créable à la main comme avant, sans invitation.
  tournamentInvitation   TournamentInvitation? @relation(fields: [tournamentInvitationId], references: [id], onDelete: SetNull)
  tournamentInvitationId String?

  // Bilan après-match. objectiveStatus répond à preMatchObjective —
  // jamais une ressaisie de l'objectif lui-même, seulement son verdict.
  objectiveStatus  String? // "ATTEINT" | "PARTIEL" | "NON_ATTEINT"
  collectiveNote   String? // bilan global (texte libre)
  firstHalfNote    String? // 1ère mi-temps : ce qui a fonctionné / problèmes rencontrés
  secondHalfNote   String? // 2ème mi-temps : idem
  positivePoints   String? // points à conserver
  improvementAreas String? // axes à retravailler — pourra alimenter la préparation des séances
  notableEvents    String? // faits marquants (texte libre, pas de minute par minute)

  convocations         MatchConvocation[]
  slots                CompositionSlot[]
  stats                MatchPlayerStat[]
  weekendAssignments   WeekendAssignment[]
  staffAssignments     MatchStaffAssignment[]
  equipmentAssignments EquipmentAssignment[]
  plateauResults       PlateauResult[]

  @@index([teamId])
  @@index([date])
  @@index([tournamentInvitationId])
}

// Invitation reçue d'un autre club à participer à un tournoi — décision du
// staff (accepter/refuser) distincte du match lui-même : un match "Tournoi"
// (Match.competition === "Tournoi") reste la réalité qui se joue, cette
// table est le suivi de la démarche qui y mène (ou pas). Jamais fusionnée
// avec CalendarEvent.kind === "tournoi", qui reste un simple événement
// d'agenda (titre/date/heure), pas un workflow de décision.
model TournamentInvitation {
  id               String    @id @default(cuid())
  organizingClub   String
  date             DateTime
  location         String?
  categories       String[]  @default([]) // catégories visées, ex. ["U12", "U13"] — l'équipe précise se choisit seulement à la création du match
  responseDeadline DateTime?
  practicalInfo    String? // frais d'engagement / format / contact — texte libre, regroupés à la demande du club
  status           String    @default("EN_ATTENTE") // "EN_ATTENTE" | "ACCEPTEE" | "REFUSEE"
  decidedAt        DateTime?
  decidedBy        User?     @relation("TournamentInvitationDecidedBy", fields: [decidedById], references: [id])
  decidedById      String?
  createdBy        User?     @relation("TournamentInvitationCreatedBy", fields: [createdById], references: [id])
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  matches Match[]

  @@index([status])
  @@index([date])
}

// Rencontres au sein d'un plateau (Match.competition === "Plateau") —
// contrairement à un match classique, un plateau n'a pas un adversaire et
// un score uniques : plusieurs petites rencontres ont lieu le même jour.
// Match.opponent/scoreFor/scoreAgainst restent inutilisés pour ce type de
// match ; chaque rencontre vit ici. `order` fixe l'ordre d'affichage
// (celui de saisie, pas forcément chronologique à la minute près).
model PlateauResult {
  id           String   @id @default(cuid())
  match        Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId      String
  opponent     String
  scoreFor     Int?
  scoreAgainst Int?
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([matchId])
}

model MatchConvocation {
  id        String   @id @default(cuid())
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId   String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId  String
  confirmed Boolean? // null = pas de réponse, true = confirmé, false = décliné — via le lien de convocation

  @@unique([matchId, playerId])
}

// ---------- Répartition du week-end ----------
// Affectation PONCTUELLE d'un joueur à une équipe pour un samedi donné — ne
// modifie JAMAIS Player.teamId (son équipe permanente). Un joueur d'U13A
// peut ainsi renforcer U13B un week-end sans que sa fiche ne change.
model WeekendAssignment {
  id            String   @id @default(cuid())
  weekStartDate DateTime // lundi de la semaine — aligné sur WeeklyAvailabilityWindow
  weekendDate   DateTime // samedi concerné
  player        Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId      String
  team          Team     @relation(fields: [teamId], references: [id])
  teamId        String
  match         Match?   @relation(fields: [matchId], references: [id])
  matchId       String?
  assignedBy    User?    @relation(fields: [assignedById], references: [id])
  assignedById  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([weekendDate, playerId]) // un joueur = une seule affectation par week-end
  @@index([weekStartDate])
  @@index([teamId])
}

// Staff encadrant un match donné (coach, adjoint, dirigeant...) — distinct de
// Team.coachId (le coach "titulaire" de l'équipe à l'année).
model MatchStaffAssignment {
  id      String @id @default(cuid())
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId String
  user    User   @relation(fields: [userId], references: [id])
  userId  String
  role    String // "Coach" | "Adjoint" | "Dirigeant" | "Entraîneur gardien" | "Vidéo" | "Autre"

  @@unique([matchId, userId, role])
}

// État de préparation du week-end : DRAFT -> VALIDATED -> PUBLISHED (convocations générées).
model WeekendPlan {
  id            String    @id @default(cuid())
  weekStartDate DateTime  @unique
  weekendDate   DateTime
  status        String    @default("DRAFT") // "DRAFT" | "VALIDATED" | "PUBLISHED"
  validatedAt   DateTime?
  validatedBy   User?     @relation(fields: [validatedById], references: [id])
  validatedById String?
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ---------- Entretiens & suivi individuel ----------
// La parole du joueur, le retour du coach, et les décisions communes sont
// des champs strictement séparés — jamais un unique champ "notes" fourre-tout.
model PlayerInterview {
  id       String @id @default(cuid())
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId String
  author   User   @relation(fields: [authorId], references: [id])
  authorId String

  date DateTime
  type String // "DEBUT_SAISON" | "POINT_INTERMEDIAIRE" | "MI_SAISON" | "FIN_SAISON" | "EXCEPTIONNEL" | "RETOUR_BLESSURE" | "CHANGEMENT_GROUPE" | "COMPORTEMENT" | "PROJET_INDIVIDUEL"

  // Parole du joueur — champs libres, jamais obligatoires
  playerFeeling      String?
  playerFeedback     String?
  playerExpectations String?
  playerDifficulties String?

  // Retour du coach
  coachFeedback    String?
  strengths        String?
  developmentAreas String?

  // Décisions communes / suivi
  agreedSummary  String?
  privateNotes   String? // jamais exposé côté parent/joueur
  nextReviewDate DateTime?

  objectives PlayerObjective[] @relation("ObjectivesFromInterview")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([playerId])
}

model PlayerObjective {
  id                     String           @id @default(cuid())
  player                 Player           @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId               String
  createdFromInterview   PlayerInterview? @relation("ObjectivesFromInterview", fields: [createdFromInterviewId], references: [id])
  createdFromInterviewId String?

  title       String
  description String?
  category    String // "TECHNIQUE" | "TACTIQUE" | "PHYSIQUE" | "MENTAL" | "COMPORTEMENT" | "AUTRE"
  status      String  @default("A_TRAVAILLER") // "A_TRAVAILLER" | "EN_PROGRESSION" | "ACQUIS" | "ABANDONNE"

  startDate   DateTime  @default(now())
  targetDate  DateTime?
  completedAt DateTime?

  visibleToPlayer Boolean @default(false) // jamais publié automatiquement — décision explicite du staff

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  updates PlayerObjectiveUpdate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([playerId])
}

model PlayerObjectiveUpdate {
  id          String          @id @default(cuid())
  objective   PlayerObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  objectiveId String
  comment     String
  createdAt   DateTime        @default(now())
}

model CompositionSlot {
  id        String @id @default(cuid())
  match     Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId   String
  slotIndex Int // position index within the chosen formation (0..7)
  player    Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId  String

  @@unique([matchId, slotIndex])
  @@unique([matchId, playerId])
}

model MatchPlayerStat {
  id       String @id @default(cuid())
  match    Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId  String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId String

  // Prévu vs réalité (V5.2 §5) : plannedRole est figé au moment où
  // generateFeuille() crée la ligne, à partir de la composition
  // (CompositionSlot) — jamais réécrit ensuite, même si role change.
  // role est la réalité du jour de match, modifiable librement par le
  // coach (ex. prévu titulaire → finalement resté remplaçant).
  plannedRole String // "Titulaire" | "Remplaçant"
  role        String // "Titulaire" | "Remplaçant"
  position    String? // poste réellement joué ce match-là — distinct de Player.position (poste habituel)
  minutes     Int
  goals       Int     @default(0)
  assists     Int     @default(0)
  note        Float?
  comment     String? // note individuelle qualitative pour ce match

  @@unique([matchId, playerId])
}

// ---------- Evaluations ----------

model EvaluationScore {
  id           String   @id @default(cuid())
  player       Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId     String
  period       String // "Septembre" | "Décembre" | "Mars" | "Juin"
  technique    Float
  tactique     Float
  physique     Float
  comportement Float
  objectives   String? // objectifs individuels fixés pour cette période
  comment      String?
  evaluator    User?    @relation(fields: [evaluatorId], references: [id])
  evaluatorId  String?
  createdAt    DateTime @default(now())

  @@unique([playerId, period])
}

// ---------- Matériel (Cockpit v1.1) ----------
// Généralisé volontairement au-delà des seuls sacs de maillots (spec §8) :
// Equipment = l'objet physique confié (un sac, un ballon, la caméra Veo...),
// EquipmentAssignment = un cycle d'attribution/retour pour cet objet, avec
// tout son historique (une ligne par attribution, jamais écrasée). Remplace
// l'ancien modèle Jersey — les 3 sacs existants sont repris tels quels par
// la migration (voir prisma/migrations), rien n'est perdu.

model Equipment {
  id       String  @id @default(cuid())
  category String // "MAILLOTS" | "BALLONS" | "CHASUBLES" | "GOURDES" | "CAMERA_VEO" | "TROUSSE_MEDICALE" | "AUTRE" — seul MAILLOTS est réellement outillé pour l'instant (§8 : prêt à étendre, pas construit en avance)
  code     String  @unique // "SAC012"
  label    String? // libellé libre, ex. "Sac de maillots U13A"
  team     Team?   @relation(fields: [teamId], references: [id])
  teamId   String?
  active   Boolean @default(true) // false = retiré du parc (perdu, hors service) — n'apparaît plus dans "Attribuer"

  assignments EquipmentAssignment[]

  createdAt DateTime @default(now())

  @@index([teamId])
  @@index([category])
}

model EquipmentAssignment {
  id          String    @id @default(cuid())
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  equipmentId String

  // Rencontre associée (facultative — un sac peut aussi être confié hors
  // contexte de match, ex. pour un entraînement) et joueur/famille
  // responsables. parentAccountId est ce qui permet de cibler le bon
  // compte parent pour le rappel (§7) — peut être null si le joueur n'a
  // pas de compte famille, auquel cas responsibleLabel reste la seule trace.
  match            Match?         @relation(fields: [matchId], references: [id], onDelete: SetNull)
  matchId          String?
  player           Player?        @relation(fields: [playerId], references: [id], onDelete: SetNull)
  playerId         String?
  parentAccount    ParentAccount? @relation(fields: [parentAccountId], references: [id], onDelete: SetNull)
  parentAccountId  String?
  responsibleLabel String // "Famille Dupont" — toujours renseigné, même sans joueur/parent lié dans l'app

  issuedDate     DateTime
  dueDate        DateTime
  returnLocation String? // lieu/événement prévu pour le retour, ex. "Entraînement du mercredi — La Profondine"

  // Cycle de retour — deux étapes distinctes et volontairement séparées
  // (§7) : parentReportedAt est déclaratif ("j'ai rapporté le sac"), jamais
  // suffisant à lui seul ; seul returnedDate (renseigné par le staff, voir
  // markEquipmentRecovered) fait foi de la récupération physique.
  parentReportedAt DateTime?
  returnedDate     DateTime?
  washed           Boolean? // lavage effectué, renseigné au retour
  condition        String? // "Bon" | "À laver" | "Abîmé"
  staffComment     String?

  status String @default("CHEZ_LE_JOUEUR") // "CHEZ_LE_JOUEUR" | "RETOUR_SIGNALE_PARENT" | "RECUPERE_STAFF" — "à attribuer"/"retour aujourd'hui"/"en retard" sont calculés, jamais stockés (src/lib/equipment.ts)

  createdBy   User?   @relation(fields: [createdById], references: [id])
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([equipmentId])
  @@index([playerId])
  @@index([parentAccountId])
  @@index([matchId])
  @@index([status])
}

// ---------- Planning: non-session/match events (réunions, tournois...) ----------

model CalendarEvent {
  id        String   @id @default(cuid())
  title     String
  kind      String // "reunion" | "tournoi" | "cohesion" | "autre"
  date      DateTime
  startTime String
  endTime   String
  location  String?
  // Déroulé de la journée (créneaux/activités) — surtout utile pour
  // "cohesion" et "tournoi", laissé disponible pour tous les types plutôt
  // que d'ajouter un champ par kind. "cohesion" est le seul kind visible
  // côté espace parent (voir src/lib/parent-planning.ts) : réunion/autre
  // restent des événements internes au staff.
  program   String?
  team      Team?    @relation(fields: [teamId], references: [id])
  teamId    String?
  teamLabel String // display label when not tied to one Team row, e.g. "Toutes"

  @@index([date])
}

// Annonce du staff diffusée dans l'Espace Parents (onglet "Infos") — un
// message court, catégorisé, jamais une notification interne au staff
// (voir Notification ci-dessous, complètement distinct) et jamais un
// événement de planning (CalendarEvent) : une annonce n'a pas de date/heure
// propre, elle informe à propos d'autre chose (un entraînement déplacé, une
// séance annulée...).
model StaffAnnouncement {
  id       String @id @default(cuid())
  title    String
  body     String
  category String // "TERRAIN" | "ANNULATION" | "WEEKEND" | "MESSAGE"

  // Cible soit toute une catégorie (U12/U13), soit une équipe précise —
  // même convention de ciblage que TrainingSession (scopeTeamId).
  targetCategory String // "U12" | "U13"
  scopeTeam      Team?   @relation(fields: [scopeTeamId], references: [id])
  scopeTeamId    String?

  author   User   @relation(fields: [authorId], references: [id])
  authorId String

  createdAt DateTime @default(now())

  @@index([targetCategory])
  @@index([scopeTeamId])
  @@index([createdAt])
}

// ---------- Notifications internes ----------

model Notification {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      String // "alert-assigned" | "convocation-response" | ...
  title     String
  body      String?
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------- Alerts (computed) — persisted "treated" flags ----------

model AlertTreated {
  id           String    @id @default(cuid())
  alertKey     String    @unique // deterministic key, e.g. "match-no-opp:{matchId}"
  status       String    @default("TRAITE") // "TRAITE" | "ASSUME" | "IGNORE" | "REVOIR"
  snoozeUntil  DateTime? // pour IGNORE/REVOIR — l'alerte redevient active passée cette date
  comment      String?
  assignedTo   User?     @relation("AlertAssignee", fields: [assignedToId], references: [id])
  assignedToId String?
  treatedBy    User?     @relation("AlertTreatedBy", fields: [treatedById], references: [id])
  treatedById  String?
  treatedAt    DateTime  @default(now())
}

// ---------- Activity log (journal d'activité du staff) ----------

model ActivityLog {
  id         String   @id @default(cuid())
  actor      User?    @relation(fields: [actorId], references: [id])
  actorId    String?
  summary    String // phrase lisible, ex. "a changé le statut de Naël ABDELMOUMENE en Blessé"
  entityType String? // "Player" | "Team" | "Match" | "TrainingSession" | "User" ...
  entityId   String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// ---------- Seasons (suivi — pas de cloisonnement des données par saison) ----------

// ---------- Physical measurements & tests ----------
// Extensible catalog rather than a fixed set of columns: a club's testing
// programme changes from season to season (a new coach adds a slalom test,
// drops another), so the list of what's measured lives in data (this
// table), not in the schema. Poids/Taille/Vitesse/Détente/Endurance are
// seeded lazily (see src/lib/measurements.ts) as a sensible starting point,
// editable/extendable from the "Mesures" screen without a code change.

model PhysicalTestType {
  id            String  @id @default(cuid())
  name          String  @unique // "Poids", "Taille", "Vitesse 20m", "Détente", "Endurance (VMA)"
  unit          String // "kg", "cm", "s", "km/h"...
  lowerIsBetter Boolean @default(false) // vrai pour un chrono : un temps plus bas = meilleure performance
  order         Int     @default(0)
  active        Boolean @default(true) // masqué de la saisie/du tableau, historique conservé

  results PhysicalTestResult[]

  createdAt DateTime @default(now())
}

model PhysicalTestResult {
  id           String           @id @default(cuid())
  player       Player           @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId     String
  testType     PhysicalTestType @relation(fields: [testTypeId], references: [id], onDelete: Cascade)
  testTypeId   String
  date         DateTime
  value        Float
  note         String?
  recordedBy   User?            @relation(fields: [recordedById], references: [id])
  recordedById String?
  createdAt    DateTime         @default(now())

  @@unique([playerId, testTypeId, date]) // re-saisir la même journée corrige plutôt que doublonne
  @@index([playerId])
  @@index([testTypeId])
}

model Season {
  id        String   @id @default(cuid())
  label     String   @unique // "2026/2027"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ---------- Settings (single row of tunable alert thresholds) ----------

model Settings {
  id             Int @id @default(1)
  seuilPresence  Int @default(60) // %
  fenetreSeances Int @default(5)
  absRecentes    Int @default(3)
  seuilANJ       Int @default(5)
  delaiEval      Int @default(60) // days
  ecartTdj       Int @default(90) // minutes
  delaiConvoc    Int @default(21) // days
  delaiMaillots  Int @default(3) // days
  periodeTdj     Int @default(30) // days
  horizonMatch   Int @default(10) // days
  minMinutes     Int @default(30)
  delaiRdv       Int @default(60) // minutes before kickoff

  // Which Team.category values make up "l'école de foot" for the purposes of
  // a StaffAccess SCHOOL-scope grant (Responsable école de foot) — configured
  // here rather than hardcoded, since which age groups exist changes over
  // time (see StaffAccess below).
  schoolFootballCategories String[] @default(["U6", "U7", "U8", "U9", "U10", "U11", "U12", "U13"])
}

// ---------- Club (single row: identité visuelle) ----------
// Le logo est stocké en base (Bytes) plutôt que sur un service externe :
// aucune solution de stockage n'existait déjà dans le projet, et un logo de
// club (quelques centaines de Ko) ne justifie pas d'introduire une nouvelle
// dépendance/service pour ce seul usage. Servi par /api/club/logo.
// Les couleurs par défaut reprennent l'identité actuelle de l'app (vert,
// bleu, orange) — un club qui n'a rien configuré ne voit aucune différence.
model Club {
  id             Int     @id @default(1)
  name           String  @default("Mon club")
  shortName      String?
  logoData       Bytes?
  logoMimeType   String?
  primaryColor   String  @default("#3F8F5B")
  secondaryColor String  @default("#3C6E9F")
  accentColor    String  @default("#C97A17")

  // Modèles éditables des messages "à copier" pour les parents (Paramètres).
  // null = texte par défaut codé en dur (src/lib/message-templates.ts).
  // Placeholders substitués à l'affichage, jamais interprétés côté club.
  availabilityMessageTemplate String? // /disponibilites — ouverture des pointages/dispos
  convocationMessageTemplate  String? // /week-end — annonce des convocations publiées

  // Injecte le bloc résultats du week-end (variable {{resultats}}) dans le
  // message d'ouverture des dispos. Défaut false — un club existant qui n'a
  // rien réglé ne voit son message changer d'aucune façon tant qu'il n'a pas
  // explicitement activé l'option depuis /parametres.
  includeWeekendResultsInAvailabilityMessage Boolean @default(false)

  updatedAt DateTime @updatedAt
}
