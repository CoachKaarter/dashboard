// Prisma schema — Cockpit U12/U13 (Saint-Sébastien FC)
// PostgreSQL (deployed on Vercel Postgres / Neon). No enums used, by
// convention from an earlier SQLite iteration; allowed value sets are
// validated at the application layer (zod) instead.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Staff / auth ----------

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String
  role         String // "ADMIN" | "COACH" | "STAFF"
  accessLabel  String // free text shown in Staff screen, e.g. "Équipes autorisées"
  jobTitle     String // e.g. "Responsable de catégorie", "Coach", "Entraîneur des gardiens"
  email        String?
  active       Boolean  @default(true) // false = compte désactivé, connexion bloquée
  teamIds      String[] @default([]) // équipes autorisées pour un COACH/STAFF ; ignoré pour ADMIN (accès total)

  teams            Team[]             @relation("TeamCoach")
  notes            PlayerNote[]
  evaluations      EvaluationScore[]
  treatedAlerts    AlertTreated[]
  historyDecisions TeamHistoryEntry[]
  unavailabilities Unavailability[]
  activityLogs     ActivityLog[]

  createdAt DateTime @default(now())
}

// ---------- Teams & players ----------

model Team {
  id         String @id @default(cuid())
  code       String @unique // "U13A"
  category   String // "U12" | "U13"
  format     String @default("Foot à 8") // "Foot à 8" | "Foot à 11"
  targetSize Int? // effectif cible — comparé à l'effectif réel sur l'écran Équipes

  coach   User?   @relation("TeamCoach", fields: [coachId], references: [id])
  coachId String?

  players        Player[]
  sessions       TrainingSession[]
  recurringSlots RecurringSlot[]
  matches        Match[]
  jerseys        Jersey[]
  calendarEvents CalendarEvent[]
  historyFrom    TeamHistoryEntry[] @relation("HistoryFromTeam")
  historyTo      TeamHistoryEntry[] @relation("HistoryToTeam")
}

model Player {
  id          String  @id @default(cuid())
  firstName   String
  lastName    String
  birthYear   Int
  team        Team    @relation(fields: [teamId], references: [id])
  teamId      String
  position    String
  positionAlt String
  foot        String // "Gauche" | "Droit" | "Les deux"
  status      String // "Actif" | "Blessé" | "Malade" | "Incertain" | "Reprise"
  joinedLabel String // "Août 2022" (display string, matches prototype)
  archived    Boolean @default(false) // joueur parti du club — masqué des listes actives, historique conservé

  notes            PlayerNote[]
  attendances      Attendance[]
  convocations     MatchConvocation[]
  compositionSlots CompositionSlot[]
  matchStats       MatchPlayerStat[]
  evaluations      EvaluationScore[]
  history          TeamHistoryEntry[]
  jerseys          Jersey[]
  unavailabilities Unavailability[]

  createdAt DateTime @default(now())

  @@index([teamId])
}

model Unavailability {
  id             String    @id @default(cuid())
  player         Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId       String
  type           String // "Blessure" | "Maladie" | "Absence longue" | "Autre"
  description    String?
  startDate      DateTime
  expectedReturn DateTime?
  actualReturn   DateTime? // renseigné quand le joueur est marqué de retour
  createdBy      User?     @relation(fields: [createdById], references: [id])
  createdById    String?
  createdAt      DateTime  @default(now())

  @@index([playerId])
}

model PlayerNote {
  id        String   @id @default(cuid())
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId  String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  text      String
  createdAt DateTime @default(now())

  @@index([playerId])
}

model TeamHistoryEntry {
  id          String   @id @default(cuid())
  player      Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId    String
  fromTeam    Team?    @relation("HistoryFromTeam", fields: [fromTeamId], references: [id])
  fromTeamId  String?
  toTeam      Team?    @relation("HistoryToTeam", fields: [toTeamId], references: [id])
  toTeamId    String?
  date        DateTime
  reason      String
  decidedBy   User?    @relation(fields: [decidedById], references: [id])
  decidedById String?

  @@index([playerId])
}

// ---------- Recurring training template ----------

model RecurringSlot {
  id          String  @id @default(cuid())
  category    String // "U12" | "U13"
  scopeTeam   Team?   @relation(fields: [scopeTeamId], references: [id])
  scopeTeamId String?
  weekday     Int // 0=dimanche .. 6=samedi
  startTime   String // "18:15"
  endTime     String // "19:45"
  location    String
  label       String // "Séance commune" | "Spécifique U13A" | "Technique"
  active      Boolean @default(true) // false = suspendu, ne génère plus de séances

  sessions TrainingSession[]

  createdAt DateTime @default(now())
}

// ---------- Training sessions (séances) & presence ----------

model TrainingSession {
  id        String   @id @default(cuid())
  date      DateTime
  startTime String // "18:15"
  endTime   String // "19:45"
  location  String
  status    String // "Prévue" | "Réalisée" | "Annulée"

  // A session targets either a whole category (U12 / U13) or one specific team
  // (e.g. "Spécifique U13A"); scopeTeam is set only in the latter case.
  category    String // "U12" | "U13"
  scopeTeam   Team?   @relation(fields: [scopeTeamId], references: [id])
  scopeTeamId String?
  label       String // "Séance commune" | "Spécifique U13A" | "Technique"
  theme       String? // thème de la séance, ex. "Conservation du ballon"
  objective   String? // objectif pédagogique, ex. "Jouer sous pression en 2 touches"

  // Set when this session was auto-generated from a RecurringSlot, so the
  // generator can tell which weeks already have a session and skip them —
  // editing/cancelling/deleting this row (an "exception") doesn't touch the
  // template itself.
  sourceSlot   RecurringSlot? @relation(fields: [sourceSlotId], references: [id])
  sourceSlotId String?

  attendances Attendance[]

  @@index([date])
}

model Attendance {
  id        String          @id @default(cuid())
  session   TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  player    Player          @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId  String
  code      String // "P" | "R" | "AJ" | "ANJ" | "B"
  note      String? // motif — ex. raison d'une absence justifiée (AJ)

  @@unique([sessionId, playerId])
  @@index([playerId])
}

// ---------- Matches ----------

model Match {
  id           String   @id @default(cuid())
  team         Team     @relation(fields: [teamId], references: [id])
  teamId       String
  opponent     String? // null = "adversaire à définir"
  competition  String // "Championnat" | "Amical" | "Plateau"
  date         DateTime
  time         String? // "10:30"
  meetTime     String? // rendez-vous
  isHome       Boolean  @default(true)
  location     String?
  status       String // "Planifié" | "Joué"
  needed       Int      @default(12)
  formation    String   @default("1-3-3-1")
  scoreFor     Int?
  scoreAgainst Int?
  shareToken   String   @unique @default(cuid()) // lien de convocation partageable, sans connexion

  preMatchObjective String? // objectif fixé avant le match
  objectiveMet      Boolean? // atteint ou non — renseigné dans le bilan après match
  collectiveNote    String? // bilan collectif après match

  convocations MatchConvocation[]
  slots        CompositionSlot[]
  stats        MatchPlayerStat[]

  @@index([teamId])
  @@index([date])
}

model MatchConvocation {
  id        String   @id @default(cuid())
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId   String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId  String
  confirmed Boolean? // null = pas de réponse, true = confirmé, false = décliné — via le lien de convocation

  @@unique([matchId, playerId])
}

model CompositionSlot {
  id        String @id @default(cuid())
  match     Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId   String
  slotIndex Int // position index within the chosen formation (0..7)
  player    Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId  String

  @@unique([matchId, slotIndex])
  @@unique([matchId, playerId])
}

model MatchPlayerStat {
  id       String  @id @default(cuid())
  match    Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId  String
  player   Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId String
  role     String // "Titulaire" | "Remplaçant"
  minutes  Int
  goals    Int     @default(0)
  assists  Int     @default(0)
  note     Float?
  comment  String? // note individuelle qualitative pour ce match

  @@unique([matchId, playerId])
}

// ---------- Evaluations ----------

model EvaluationScore {
  id           String   @id @default(cuid())
  player       Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId     String
  period       String // "Septembre" | "Décembre" | "Mars" | "Juin"
  technique    Float
  tactique     Float
  physique     Float
  comportement Float
  objectives   String? // objectifs individuels fixés pour cette période
  comment      String?
  evaluator    User?    @relation(fields: [evaluatorId], references: [id])
  evaluatorId  String?
  createdAt    DateTime @default(now())

  @@unique([playerId, period])
}

// ---------- Jerseys / matériel ----------

model Jersey {
  id           String    @id @default(cuid())
  code         String    @unique // "SAC012"
  team         Team      @relation(fields: [teamId], references: [id])
  teamId       String
  player       Player?   @relation(fields: [playerId], references: [id])
  playerId     String?
  responsible  String // "Famille Berthier"
  issuedDate   DateTime
  dueDate      DateTime
  returnedDate DateTime?
  condition    String // "Bon" | "À laver" | "Abîmé"
}

// ---------- Planning: non-session/match events (réunions, tournois...) ----------

model CalendarEvent {
  id        String   @id @default(cuid())
  title     String
  kind      String // "reunion" | "tournoi" | "autre"
  date      DateTime
  startTime String
  endTime   String
  location  String?
  team      Team?    @relation(fields: [teamId], references: [id])
  teamId    String?
  teamLabel String // display label when not tied to one Team row, e.g. "Toutes"

  @@index([date])
}

// ---------- Alerts (computed) — persisted "treated" flags ----------

model AlertTreated {
  id          String   @id @default(cuid())
  alertKey    String   @unique // deterministic key, e.g. "match-no-opp:{matchId}"
  treatedBy   User?    @relation(fields: [treatedById], references: [id])
  treatedById String?
  treatedAt   DateTime @default(now())
}

// ---------- Activity log (journal d'activité du staff) ----------

model ActivityLog {
  id         String   @id @default(cuid())
  actor      User?    @relation(fields: [actorId], references: [id])
  actorId    String?
  summary    String // phrase lisible, ex. "a changé le statut de Naël ABDELMOUMENE en Blessé"
  entityType String? // "Player" | "Team" | "Match" | "TrainingSession" | "User" ...
  entityId   String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// ---------- Settings (single row of tunable alert thresholds) ----------

model Settings {
  id             Int @id @default(1)
  seuilPresence  Int @default(60) // %
  fenetreSeances Int @default(5)
  absRecentes    Int @default(3)
  seuilANJ       Int @default(5)
  delaiEval      Int @default(60) // days
  ecartTdj       Int @default(90) // minutes
  delaiConvoc    Int @default(21) // days
  delaiMaillots  Int @default(3) // days
  periodeTdj     Int @default(30) // days
  horizonMatch   Int @default(10) // days
  minMinutes     Int @default(30)
  delaiRdv       Int @default(60) // minutes before kickoff
}
